# Copy to .env.local (git-ignored) or set in the hosting provider's build environment.
# Analytics stays off unless BOTH PostHog values are set — and it is always off in `npm run dev`.
# See docs/ANALYTICS.md.

# PostHog project API key (the public "phc_…" key; it can only write events).
VITE_POSTHOG_KEY=
# PostHog ingestion host for the project's region, e.g. https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Set to true to log analytics events to the browser console instead of sending them (works in dev).
# VITE_ANALYTICS_DEBUG=true

# Optional: overrides the git SHA used as `app_version` (hosts without a .git checkout can set it).
# Vercel, Cloudflare Pages, Netlify and GitHub Actions commit variables are picked up automatically.
# APP_VERSION=
